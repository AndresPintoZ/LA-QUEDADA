# Convenciones de formato de PlanVibe. Aplican a todos los editores e IDEs.
#
# Aquí solo hay reglas de FORMATO, comunes a todo el repositorio. Las reglas de
# análisis de C# viven en `backend/.editorconfig`, junto al código al que afectan.
#
# El motivo no es organizativo: el contexto de compilación de la imagen de Docker
# es `./backend`, así que un archivo que esté en esta carpeta NO llega al
# contenedor. Tener aquí las supresiones de analizadores hacía que `dotnet build`
# funcionara en local y fallara dentro de Docker.
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

[*.{cs,csx}]
indent_size = 4
max_line_length = 140

[*.{ts,tsx,js,jsx,mjs,cjs,json,jsonc,yml,yaml,css}]
indent_size = 2

[*.md]
indent_size = 2
trim_trailing_whitespace = false

[*.{csproj,props,targets,xml}]
indent_size = 2
