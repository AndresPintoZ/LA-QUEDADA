<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <!--
    Seguridad de la cadena de suministro: se limpian las fuentes heredadas de la máquina
    y solo se permite nuget.org. Así una fuente local mal configurada no puede inyectar
    un paquete con el mismo nombre que uno público (ataque de confusión de dependencias).
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>

  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>

</configuration>
