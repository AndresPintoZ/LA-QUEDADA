<Project Sdk="Microsoft.NET.Sdk">

  <!-- Pruebas unitarias del dominio: rápidas, sin base de datos, sin red. Son la red de seguridad del TDD. -->
  <PropertyGroup>
    <RootNamespace>PlanVibe.Domain.UnitTests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- xUnit v3 ejecuta cada proyecto de prueba como aplicación de consola independiente. -->
    <OutputType>Exe</OutputType>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\PlanVibe.Domain\PlanVibe.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Shouldly" />
    <PackageReference Include="coverlet.collector" />
  </ItemGroup>

</Project>
