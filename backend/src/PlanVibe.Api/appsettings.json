{
  "//": "Configuración base. NUNCA se ponen aquí secretos: la cadena de conexión y la clave de firma llegan por variable de entorno (ver docker/.env.example).",

  "ConnectionStrings": {
    "PlanVibe": ""
  },

  "Jwt": {
    "Emisor": "planvibe-api",
    "Audiencia": "planvibe-web",
    "MinutosDeAcceso": 15,
    "DiasDeRenovacion": 14
  },

  "Cors": {
    "//": "Lista explícita de orígenes. Con la arquitectura BFF, quien llama a la API es el servidor de Next.",
    "OrigenesPermitidos": [ "http://localhost:3000" ]
  },

  "Nominatim": {
    "UrlBase": "https://nominatim.openstreetmap.org/",
    "UserAgent": "PlanVibe/0.1 (piloto Ávila; contacto@planvibe.es)",
    "PaisPreferente": "es",
    "MaximoResultados": 5,
    "MinutosDeCache": 60
  },

  "VerificacionSimulada": {
    "//": "Solo se activa en desarrollo, con independencia de lo que diga este valor.",
    "Activo": false,
    "UrlDeRetorno": "http://localhost:3000/verificacion/resultado"
  },

  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    }
  },

  "AllowedHosts": "*"
}
