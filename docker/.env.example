# =============================================================================
# Plantilla de configuración local de PlanVibe.
#
#   1. Copia este archivo a la raíz del repositorio con el nombre .env
#   2. Genera los dos secretos con los comandos de abajo
#   3. docker compose up -d --build
#
# El archivo .env está en .gitignore y NUNCA debe subirse al repositorio.
# Los valores de aquí son solo para desarrollo local: en producción los secretos
# se gestionan con un almacén de secretos, no con un archivo.
# =============================================================================

# --- Base de datos -----------------------------------------------------------
POSTGRES_DB=planvibe
POSTGRES_USER=planvibe

# Contraseña de PostgreSQL. Genera una nueva, no uses la de ningún ejemplo.
#
# IMPORTANTE: no uses Get-Random para generar secretos. Es un generador
# pseudoaleatorio predecible: quien conozca una salida puede deducir las
# siguientes. Para claves hace falta un generador criptográficamente seguro.
#
#   PowerShell:  $r=[Security.Cryptography.RNGCryptoServiceProvider]::new(); $b=[byte[]]::new(24); $r.GetBytes($b); ($b|%{$_.ToString("x2")}) -join ''
#   Bash:        openssl rand -hex 24
POSTGRES_PASSWORD=

# Puerto local en el que se publica PostgreSQL. Solo escucha en 127.0.0.1.
POSTGRES_PORT=5432

# --- API ---------------------------------------------------------------------
# Development activa la documentación interactiva y el proveedor de verificación
# simulado. NUNCA uses Development fuera de tu equipo.
ASPNETCORE_ENVIRONMENT=Development

API_PORT=8080

# Clave de firma de los tokens de acceso. Mínimo 64 caracteres: la aplicación
# se niega a arrancar con una clave más corta.
#   PowerShell:  $r=[Security.Cryptography.RNGCryptoServiceProvider]::new(); $b=[byte[]]::new(64); $r.GetBytes($b); ($b|%{$_.ToString("x2")}) -join ''
#   Bash:        openssl rand -hex 64
JWT_CLAVE=

# Detalle de errores de PostgreSQL en los mensajes. Útil al desarrollar, pero
# expone nombres de columnas y restricciones: déjalo en false salvo que lo necesites.
INCLUIR_DETALLE_DE_ERROR=false

# --- Web ---------------------------------------------------------------------
WEB_PORT=3000
URL_WEB=http://localhost:3000

# Secreto con el que el BFF de Next cifra la cookie de sesión. Mínimo 32 caracteres.
#   PowerShell:  $r=[Security.Cryptography.RNGCryptoServiceProvider]::new(); $b=[byte[]]::new(32); $r.GetBytes($b); ($b|%{$_.ToString("x2")}) -join ''
#   Bash:        openssl rand -hex 32
SESION_SECRETO=

# --- Servicios externos ------------------------------------------------------
# Nominatim (OpenStreetMap) exige identificar la aplicación con un contacto real.
# Pon aquí tu correo: es la condición de uso del servicio, que es gratuito.
NOMINATIM_USER_AGENT=PlanVibe/0.1 (desarrollo local; tu-correo@ejemplo.com)
